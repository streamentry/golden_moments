  "homeGuideNotMedical": "Golden Moments பொழுதுபோக்கையும் சேர்ந்து பேசும் வாய்ப்பையும் தருகிறது. இது டிமென்ஷியா அல்லது அல்சைமர் நோயைக் கண்டறியவோ, சிகிச்சையளிக்கவோ, தடுக்கவோ, அளவிடவோ செய்யாது.",
  "homeGuidePhotoCopies": "குடும்பப் புகைப்பட நகல்கள் இந்தச் சாதனத்தில் சேமிக்கப்படுகின்றன; சாதன காப்புப்பிரதிகளில் சேரக்கூடும். இந்த நகல்களை ஆப் பதிவேற்றாது, உறவினர்களிடையே ஒத்திசைக்காது. படத் தொகுப்பு ஆப்புடன் சேர்ந்தே வருகிறது; இணையம் இல்லாமல் இயங்கும்.",
  "homeGuideMoreHelp": "கூடுதல் உதவி மற்றும் தனியுரிமை",
  "gentleGameTitle": "மென்மையான படப் பொருத்தம்",
  "gentleGameHowThisWorks": "இது எப்படி இயங்கும்",
  "gentleGameHelpHowToPlay": "ஒரு படத்தைத் தொடுங்கள், பிறகு இன்னொன்றைத் தொடுங்கள். பொருந்தும் படங்கள் சேர்ந்தே இருக்கும். பொருந்தாத படங்கள் அடுத்த முறை தொடும் வரை தெரிந்தபடியே இருக்கும்.",
  "gentleGameHelpNoWrongAnswer": "நேர வரம்பும் தவறான பதிலும் இல்லை. படங்களை வெறுமனே பார்க்கலாம், அவற்றைப் பற்றிப் பேசலாம், கட்டங்களின் எண்ணிக்கையை மாற்றலாம், அல்லது “இப்போதைக்கு போதும்” என்பதைத் தொட்டு நிறுத்தலாம்.",
  "gentleGameBackToPictures": "படங்களுக்குத் திரும்பு",
  "gentleGameNeedTwoPhotos": "விளையாட குறைந்தது இரண்டு புகைப்படங்களைத் தேர்ந்தெடுங்கள்.",
  "gentleGameInstruction": "பொருந்தும் இரண்டு படங்களைத் தொடுங்கள்.",
  "gentleGameInstructionNoTimeLimit": "பொருந்தும் இரண்டு படங்களைத் தொடுங்கள். நேர வரம்பு இல்லை.",
  "gentleGameWaitingStatus": "நிதானமாக ஆகட்டும். தொடர ஒரு படத்தைத் தொடுங்கள்.",
  "gentleGameAllPairsTogether": "எல்லா ஜோடிகளும் சேர்ந்துவிட்டன.",
  "gentleGameFinishedStatus": "மீண்டும் விளையாடலாம், அல்லது ஓய்வெடுக்கலாம்.",
  "gentleGameTileLabel": "{picture}, கட்டம் {position}",
  "gentleGameHiddenTileLabel": "மறைந்த படம், கட்டம் {position}",
  "gentleGameResumeTitle": "விட்ட இடத்திலிருந்து தொடரலாமா?",
  "gentleGameResumeBody": "உங்களிடம் பாதியில் உள்ள பலகை ஒன்று உள்ளது. அதைத் தொடரலாம், அல்லது புதியதைத் தொடங்கலாம்.",
  "gentleGameResumeStartFresh": "புதிதாகத் தொடங்கு",
  "gentleGameResumeCarryOn": "தொடரலாம்",
  "gentleGameDiscardBody": "இந்தப் பலகையில் நீங்கள் கண்டுபிடித்த படங்கள் அழிக்கப்படும்.",
  "gentleGameStartAgainQuestion": "மீண்டும் தொடங்கலாமா?",
  "gentleGameChangeTilesQuestion": "கட்டங்களின் எண்ணிக்கையை மாற்றலாமா?",
  "gentleGameChangeTilesAction": "மாற்று",
  "gentleGameResetComfortQuestion": "வசதி அமைப்புகளை மீட்டமைக்கலாமா?",
  "comfortChangesApply": "மாற்றங்கள் உடனே செயல்படும்; நினைவில் வைக்கப்படும்.",
  "comfortNumberOfTiles": "கட்டங்களின் எண்ணிக்கை",
  "comfortTileCount": "{count, plural, =1{1 கட்டம்} other{{count} கட்டங்கள்}}",
  "comfortKeepVisible": "படங்களைத் தெரியும்படி வை",
  "comfortKeepVisibleHint": "மறைந்த கட்டங்கள் வேண்டுமென்றால் மட்டும் இதை அணைக்கவும்.",
  "comfortSaveFailed": "இந்தத் தேர்வுகளைச் சேமிக்க முடியவில்லை. ஆப்பை மூடும் வரை இவை செயல்படும்.",
  "comfortResetButton": "வசதி அமைப்புகளை மீட்டமை",
  "comfortResetBody": "இது கட்டங்களின் எண்ணிக்கையையும் படக் காட்சியையும் தொடக்கத் தேர்வுகளுக்கு மட்டுமே திருப்பும். உங்கள் புகைப்படங்களும் படத் தொகுப்புகளும் மாறாது.",
  "comfortKeepMySettings": "என் அமைப்புகளை வை",
  "helpTitle": "உதவி மற்றும் தனியுரிமை",
  "helpWorksOffline": "இந்தப் பக்கம் இணையம் இல்லாமல் இயங்கும்.",
  "helpTogetherHeading": "சேர்ந்து மகிழ்தல்",
  "helpTogetherInterests": "அவருடைய விருப்பங்களைப் பின்பற்றுங்கள். படங்களைத் தெரியும்படி வையுங்கள், குறைவான கட்டங்களைப் பயன்படுத்துங்கள், அல்லது சேர்ந்து பாருங்கள். பெயர்களை நினைவுகூரவோ விளையாட்டை முடிக்கவோ தேவையில்லை. எப்போது வேண்டுமானாலும் நிறுத்தலாம், அல்லது செயல்பாட்டை மாற்றலாம்.",
  "helpTogetherNotMedical": "Golden Moments பொழுதுபோக்கையும் சேர்ந்து பேசும் வாய்ப்பையும் தருகிறது. இது டிமென்ஷியா அல்லது அல்சைமர் நோயைக் கண்டறியவோ, சிகிச்சையளிக்கவோ, தடுக்கவோ, அளவிடவோ செய்யாது.",
  "helpPhotosHeading": "உங்கள் புகைப்படங்களும் தனியுரிமையும்",
  "helpPhotosChoose": "எந்தப் புகைப்படங்களைச் சேர்ப்பது என்பதை நீங்களே தேர்ந்தெடுக்கிறீர்கள். நகல்கள் இந்தச் சாதனத்தில் வைக்கப்படும்; உங்கள் அசல் புகைப்படங்கள் ஒருபோதும் மாற்றப்படாது. கணக்கும் இல்லை, குடும்ப ஒத்திசைவும் இல்லை.",
  "helpPhotosBackups": "நகல்கள் உங்கள் தொலைபேசியின் காப்புப்பிரதிகளில் சேரக்கூடும். இங்கே ஒரு நகலை நீக்கினாலும் முந்தைய காப்புப்பிரதியோ, ஏற்கெனவே யாராவது பெற்ற படமோ அழியாது.",
  "helpPhotosLibrary": "படத் தொகுப்பு ஆப்புடன் சேர்ந்தே வருகிறது; இணையம் இல்லாமல் இயங்கும்.",
  "helpTroubleHeading": "ஏதாவது சரியாக நடக்கவில்லை என்றால்",
  "helpTroublePhotos": "புகைப்படங்கள் சேரவில்லை என்றால்: குறைவான அல்லது சிறிய புகைப்படங்களைத் தேர்ந்தெடுத்து, காலி இடத்தைப் பாருங்கள். ஏற்கெனவே சேமித்தவை மாறாது.",
  "helpTroubleGame": "விளையாட்டு நீங்கள் விட்ட இடத்தில் இல்லை என்றால்: “புதிதாகத் தொடங்கு” என்பதைத் தேர்ந்தெடுங்கள். உங்கள் புகைப்படங்களும் அமைப்புகளும் பாதிக்கப்படாது.",
  "helpTroubleTextSize": "எழுத்துகளோ பொத்தான்களோ பயன்படுத்த கடினமாக இருந்தால்: உங்கள் தொலைபேசியின் அமைப்புகளில் எழுத்து அளவை மாற்றுங்கள். ஆப் அதைப் பின்பற்றும்.",
  "helpReachHeading": "எங்களைத் தொடர்புகொள்ள",
  "helpReachEmail": "{email} முகவரிக்கு மின்னஞ்சல் அனுப்பலாம் (அதை நகலெடுக்கவும்; ஆப் உங்கள் மின்னஞ்சலைத் திறக்காது), அல்லது கீழே ஒரு குறிப்பையோ சிக்கல் அறிக்கையையோ அனுப்பலாம். எது அனுப்பப்படும் என்பதை நீங்களே சரிபார்க்கலாம். எதுவும் தானாக அனுப்பப்படாது.",
  "helpOnlineHelp": "இணைப்பில் இருக்கும்போது இணைய உதவி (இதை உங்கள் உலாவியில் நகலெடுத்து ஒட்டுங்கள்; ஆப் இதைத் திறக்காது):",
  "helpPolicyLinks": "தனியுரிமைக் கொள்கையும் பயன்பாட்டு விதிமுறைகளும் (இவையும் நகலெடுக்க மட்டுமே; ஆப் இவற்றைத் திறக்காது):",
  "helpWriteNote": "குறிப்பு எழுதுங்கள்",
  "helpRateHeading": "மற்ற குடும்பங்களுக்குச் சொல்லுங்கள்",
  "helpRateBody": "Golden Moments உங்களுக்குப் பயன்பட்டிருந்தால், கடையில் நீங்கள் தரும் மதிப்பீடு மற்ற குடும்பங்கள் இதைக் கண்டறிய உதவும். இது முழுக்க விருப்பமானது; எங்களுக்கு எழுதுவதிலிருந்து தனியானது.",
  "helpRateButton": "Golden Moments-ஐ மதிப்பிடுங்கள்",
  "helpVersion": "பதிப்பு {version}",
  "helpStatusShared": "நன்றி. வேறு எதுவும் அனுப்பப்படவில்லை.",
  "helpStatusDismissed": "எதுவும் அனுப்பப்படவில்லை. மீண்டும் முயலலாம்.",
  "helpStatusUnknown": "பகிர்வு சாளரம் மூடப்பட்டது. நீங்கள் அனுப்பியிருந்தால், நன்றி. வேறு எதுவும் அனுப்பப்படவில்லை.",
  "helpStatusStoreFailed": "கடையைத் திறக்க முடியவில்லை. Golden Moments-ஐ பின்னர் அங்கே காணலாம்.",
  "helpNoteSubject": "Golden Moments குறிப்பு",
  "helpProblemSubject": "Golden Moments சிக்கல் அறிக்கை",
  "helpNoteField": "உங்கள் குறிப்பு",
  "helpNoteFieldHint": "பெயர்கள், முகவரிகள், தனிப்பட்ட எதையும் தவிர்க்கவும்.",
  "helpNotePreviewHeading": "இதுவே சரியாகப் பகிரப்படும்:",
  "helpProblemPreviewHeading": "இதுவே சரியாகப் பகிரப்படும். இதில் புகைப்படங்கள், பெயர்கள், கோப்பு விவரங்கள் இல்லை:",
  "helpChooseWhereToSend": "எங்கே அனுப்ப வேண்டும் எனத் தேர்ந்தெடுங்கள்",
  "legalTitle": "தனியுரிமையும் தகவலும்",
  "legalHeading": "உங்கள் படங்கள், உங்கள் விருப்பம்",
  "legalNoAccount": "Golden Moments கணக்கோ குடும்பப் புகைப்பட சர்வரோ இல்லை. நீங்கள் குடும்பப் புகைப்படங்களைத் தேர்ந்தெடுக்கும்போது, ஆப் இந்தச் சாதனத்தில் வேலை நகல்களை வைத்துக்கொள்ளும். சாதன காப்புப்பிரதிகளில் அந்த நகல்கள் சேரக்கூடும்.",
  "legalBuiltInPictures": "தனிப்பட்ட புகைப்படங்கள் எதையும் தேர்ந்தெடுக்காமல், உள்ளமைந்த படச் செயல்பாடுகளைப் பயன்படுத்தலாம்.",
  "legalPrivacyPolicyLink": "மொபைல் ஆப் தனியுரிமைக் கொள்கை",
  "legalPrivacyPolicyDescription": "உங்கள் சாதனத்தில் இருப்பவை, வெளிச் சேவைகள், உதவி மின்னஞ்சல், தரவு வைத்திருக்கும் காலம்.",
  "legalPrivacyChoicesLink": "தனியுரிமைத் தேர்வுகளும் நீக்கலும்",
