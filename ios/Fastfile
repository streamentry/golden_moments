default_platform(:ios)

platform :ios do
  desc "Generate certificates and provisioning profiles"
  lane :certificates do
    # Create or update certificates and provisioning profiles
    match(
      type: "appstore",
      app_identifier: "com.mindfulness.golden_moments",
      readonly: false,
      force_for_new_devices: true,
      skip_confirmation: true
    )
    
    match(
      type: "development", 
      app_identifier: "com.mindfulness.golden_moments",
      readonly: false,
      force_for_new_devices: true,
      skip_confirmation: true
    )
  end

  desc "Build and sign the app for development/testing"
  lane :build_development do
    # Ensure we have the latest development certificates
    match(
      type: "development",
      app_identifier: "com.mindfulness.golden_moments",
      readonly: true,
      skip_confirmation: true
    )

    # Build the Flutter app
    sh("cd ../.. && flutter build ios --release --no-codesign")

    # Build and sign the iOS app for development
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "development",
      output_directory: "./build",
      output_name: "golden_moments_dev.ipa",
      skip_profile_detection: true
    )
  end

  desc "Upload to TestFlight"
  lane :testflight do
    # Build the app
    build_development

    # Upload to TestFlight
    upload_to_testflight(
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  desc "Deploy to App Store"
  lane :release do
    # Build the app
    build_development

    # Upload to App Store
    upload_to_app_store(
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_screenshots: true,
      skip_metadata: true
    )
  end

  desc "Sync certificates and provisioning profiles"
  lane :sync_certificates do
    match(
      type: "development",
      app_identifier: "com.mindfulness.golden_moments",
      readonly: true,
      skip_confirmation: true
    )
    
    match(
      type: "appstore", 
      app_identifier: "com.mindfulness.golden_moments",
      readonly: true,
      skip_confirmation: true
    )
  end
end
