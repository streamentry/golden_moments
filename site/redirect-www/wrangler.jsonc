{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Sends www.dementiaactivities.games to the apex with a permanent redirect,
  // keeping the path and query. Nothing is logged or stored.
  "name": "dementia-activities-www-redirect",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "www.dementiaactivities.games", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}
