---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import Analytics from '../components/Analytics.astro';
import { SITE, absoluteUrl } from '../lib/site';
import { DEFAULT_LOCALE, isIndexable, localeInfo, localePath, splitLocale } from '../i18n/locales';
import { PUBLISHED, ui } from '../i18n/ui';

interface Props {
  /** Full <title>. Pages normally pass `title` and get the suffix added. */
  title: string;
  description: string;
  rawTitle?: boolean;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** False on pages that handle family photos, which allow no third-party scripts. */
  analytics?: boolean;
  /** Language codes this page exists in; defaults to English only. */
  available?: readonly string[];
}

const {
  title,
  description,
  rawTitle = false,
  image = '/og/default.png',
  imageAlt,
  type = 'website',
  jsonLd = [],
  noindex = false,
  analytics = true,
} = Astro.props;

const { code: lang, path } = splitLocale(Astro.url.pathname);
const locale = localeInfo(lang);
const t = ui(lang);
// Pages declare the languages they exist in; anything else is English only.
const available = Astro.props.available ?? [DEFAULT_LOCALE];
// Only reviewed languages are advertised as alternates; machine translations are noindex.
const alternates = PUBLISHED.filter((l) => available.includes(l.code) && isIndexable(l.code));
const blockIndexing = noindex || !isIndexable(lang);
const fullTitle = rawTitle ? title : `${title}${t.common.titleSuffix}`;
const canonical = absoluteUrl(Astro.url.pathname);
const ogImage = absoluteUrl(image);
const altText = imageAlt ?? t.common.defaultImageAlt;
---
<!doctype html>
<html lang={locale.htmlLang} dir={locale.dir}>
  <head>
    <meta charset="utf-8" />
    {analytics && <Analytics />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alternates.length > 1 &&
        alternates.map((l) => <link rel="alternate" hreflang={l.bcp47} href={absoluteUrl(localePath(l.code, path))} />)
    }
    {alternates.length > 1 && <link rel="alternate" hreflang="x-default" href={absoluteUrl(path)} />}
    {blockIndexing && <meta name="robots" content="noindex, follow" />}
    {!blockIndexing && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <meta name="theme-color" content="#FDF9F0" />
    <meta name="color-scheme" content="only light" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="LLM summary" href="/llms.txt" />

    <link rel="preload" href="/fonts/fraunces-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/roboto-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/roboto-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={locale.og} />
    {alternates.filter((l) => l.code !== lang).map((l) => <meta property="og:locale:alternate" content={l.og} />)}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={altText} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={altText} />
    <meta name="apple-itunes-app" content="app-id=6749312459" />
    {jsonLd.length > 0 && <JsonLd data={jsonLd} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.common.skipLink}</a>
    <Header lang={lang} />
    {
      lang !== DEFAULT_LOCALE && (
        <p class="mt-notice container">
          {t.common.machineTranslated} <a href={path} hreflang="en" lang="en">{t.common.readOriginal}</a>
        </p>
      )
    }
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} available={available} path={path} />
  </body>
</html>
