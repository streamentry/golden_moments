---
import type { GetStaticPaths } from 'astro';
import GameView from '../../../views/GameView.astro';
import { GAMES, type GameInfo } from '../../../data/games';
import { TRANSLATED } from '../../../i18n/ui';

export const getStaticPaths = (() =>
  TRANSLATED.flatMap((l) => GAMES.map((g) => ({ params: { lang: l.prefix, slug: g.slug }, props: { game: g, lang: l.code } })))) satisfies GetStaticPaths;

interface Props {
  game: GameInfo;
  lang: string;
}
---
<GameView game={Astro.props.game} lang={Astro.props.lang} />
