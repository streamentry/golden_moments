---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GameCard from '../../components/GameCard.astro';
import Faq from '../../components/Faq.astro';
import { GAMES, STAGE_LABEL, type Stage } from '../../data/games';
import { absoluteUrl } from '../../lib/site';
import { breadcrumbs, faqPage } from '../../lib/schema';

const crumbs = [{ href: '/games/', label: 'Games' }];
const stages: Stage[] = ['early', 'middle', 'late'];
const faq = [
  {
    q: 'Which game should we start with?',
    a: 'Picture pairs with four tiles is a calm first choice. If choosing between pictures feels like too much, try Find the same with two pictures. For a group, try Picture bingo.',
  },
  {
    q: 'Do the games work on an iPad or phone?',
    a: 'Yes. Every game works in the browser on phones, tablets and computers, and the pictures grow to fill the screen. A tablet on a stand is often the most comfortable for two people.',
  },
  {
    q: 'Are there games for groups in a care home?',
    a: 'Yes. Picture bingo has printable cards and an on-screen caller, and Finish the saying and Conversation cards work well read aloud to a group.',
  },
];
const itemList = {
  '@type': 'ItemList',
  name: 'Gentle games for people with dementia',
  itemListElement: GAMES.map((g, i) => ({ '@type': 'ListItem', position: i + 1, url: absoluteUrl(`/games/${g.slug}/`), name: g.name })),
};
---
<BaseLayout
  title="Free Dementia Games Online: Gentle Picture Games"
  description="Free online games for people living with dementia: picture matching, easy jigsaws, sorting, sayings, coloring, bingo and more. No sign-up, no timers, no scores."
  jsonLd={[breadcrumbs(crumbs), itemList, faqPage(faq)]}
>
  <Breadcrumbs items={crumbs} />
  <div class="container">
    <header class="page-head">
      <h1>Gentle Games for People with Dementia</h1>
      <p class="lede">
        {GAMES.length} free games to play together in your browser. Large pictures, plain words, and nothing to fail:
        no timers, no scores, no sign-up.
      </p>
    </header>
    <ul class="card-grid">
      {GAMES.map((g) => <li><GameCard game={g} headingLevel="h2" /></li>)}
    </ul>

    <section class="section" aria-labelledby="by-stage">
      <h2 id="by-stage">Choosing a game by stage</h2>
      <p class="lede">Stages are only a rough guide. Follow what the person enjoys and what feels comfortable today.</p>
      <div class="stage-table">
        <table>
          <thead>
            <tr><th scope="col">Stage</th><th scope="col">Games that often suit</th></tr>
          </thead>
          <tbody>
            {
              stages.map((st) => (
                <tr>
                  <th scope="row">{STAGE_LABEL[st]}</th>
                  <td>
                    {GAMES.filter((g) => g.stages.includes(st)).map((g, i, arr) => (
                      <>
                        <a href={`/games/${g.slug}/`}>{g.name}</a>
                        {i < arr.length - 1 ? ', ' : ''}
                      </>
                    ))}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p>More ideas away from the screen: <a href="/activities/ideas/">101 activities for people with dementia</a>.</p>
    </section>
    <div class="narrow">
      <Faq items={faq} />
    </div>
  </div>
</BaseLayout>

<style>
  .stage-table {
    overflow-x: auto;
    margin-block: var(--space-lg);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-md);
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 14px;
    border-bottom: 1px solid var(--gm-surface-sunken);
  }
  thead th {
    background: var(--gm-surface);
    border-bottom: 2px solid var(--gm-outline);
  }
  tbody th {
    white-space: nowrap;
  }
</style>
