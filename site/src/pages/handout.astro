---
import PageLayout from '../layouts/PageLayout.astro';
import { GAME_BY_SLUG } from '../data/games';
import { SITE } from '../lib/site';

const picks = ['picture-pairs', 'find-the-same', 'finish-the-saying', 'picture-puzzle', 'conversation-cards', 'coloring']
  .map((s) => GAME_BY_SLUG.get(s as Parameters<typeof GAME_BY_SLUG.get>[0]))
  .filter((g) => g !== undefined);
---
<PageLayout
  title="Free, Gentle Games for People Living with Dementia"
  seoTitle="Printable Handout: Free Dementia Games Online"
  description="A one-page printable handout for families and caregivers about free, gentle picture games for people living with dementia, for support groups and care packets."
  path="/handout/"
  crumb="Printable handout"
  lede="Print this page for a support group, care packet or the fridge door. Use your browser's Print command; the menus and buttons are left off the printout."
>
  <p class="handout-url">{SITE.domain}</p>
  <p>
    Large pictures, plain words and nothing to fail. Free on a phone, tablet or computer, with no sign-up, no ads, no
    timers and no scores. Sit side by side and take turns.
  </p>

  <h2>Games to try together</h2>
  <ul>
    {picks.map((g) => <li><strong>{g.name}.</strong> {g.short}</li>)}
  </ul>

  <h2>A few tips</h2>
  <ul>
    <li>Choose a time of day when the person is at their best.</li>
    <li>Start with the easiest setting. Four tiles is plenty.</li>
    <li>Talk about the pictures. The conversation is often the best part.</li>
    <li>Stop while it still feels pleasant. Ending early is a good outcome.</li>
  </ul>

  <h2>Also on the site</h2>
  <ul>
    <li>Free printables: large-print word search, coloring pages, conversation cards and picture bingo.</li>
    <li>Activity ideas for every stage, and guides on playing together and on caring for yourself.</li>
  </ul>

  <p class="muted">
    For enjoyment and time together. Not medical advice, a test or a treatment. Golden Moments is published by Cloudjet
    Solutions Pte. Ltd.
  </p>
</PageLayout>

<style>
  .handout-url {
    margin-block: var(--space-md);
    font-size: var(--text-h2);
    font-weight: 700;
    color: var(--gm-on-surface);
  }
</style>
