---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import GuideCard from '../components/GuideCard.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import PlayCta from '../components/PlayCta.astro';
import { GAMES } from '../data/games';
import { pictureUrl } from '../data/pictures';
import { SITE } from '../lib/site';
import { faqPage, organization, website } from '../lib/schema';

const featured = GAMES.filter((g) => g.featured).slice(0, 6);

const faq = [
  {
    q: 'What are good games for people with dementia?',
    a: 'Good games are simple, familiar and free of pressure: large pictures to match, sorting, easy jigsaws, finishing well-known sayings, coloring, picture bingo and conversation cards. The best choice is the one the person enjoys today. Avoid timers, scores and anything that feels like a test.',
  },
  {
    q: 'Are these dementia games free?',
    a: 'Yes. Every game and printable on Golden Moments is free, with no account, sign-up or download. The games run in the web browser on a phone, tablet or computer.',
  },
  {
    q: 'Do brain games prevent dementia?',
    a: 'No game has been shown to prevent dementia, and Golden Moments does not claim to treat or prevent anything. Our games are for enjoyment and time together. Our brain health section explains what research does and does not show.',
  },
  {
    q: 'Can someone with later-stage dementia use these activities?',
    a: 'Often, yes, with someone beside them. Start with Find the same with two pictures, Picture pairs with four tiles, a coloring page or a calm breathing pause. Keep it short, follow their lead and stop when they have had enough.',
  },
  {
    q: 'Is my information private?',
    a: 'The site has no accounts and no advertising. We use Google Analytics to understand which pages are visited. Photos you choose for Photo pairs are shown only in your browser and are never uploaded.',
  },
  {
    q: 'Who makes Golden Moments?',
    a: 'Golden Moments is a small team making calm, adult picture activities for families and caregivers, on the web and as a free app. We are not clinicians, and nothing here is medical advice.',
  },
];

const jsonLd = [website(), organization(), faqPage(faq)];
const collage = ['teacup', 'sunflower', 'dog', 'sailboat'];
---
<BaseLayout title={SITE.homeTitle} rawTitle description={SITE.description} jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Free · No sign-up · No timers or scores</p>
        <h1 id="hero-title">Gentle Games &amp; Activities for People with Dementia</h1>
        <p class="lede">
          Simple picture games, familiar photos, and activities to enjoy together—at your own pace.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary btn--hero" href="/games/picture-pairs/"><Icon name="play" />Play a Game</a>
          <a class="btn btn--hero" href="/activities/ideas/">Find activity ideas</a>
        </div>
        <ul class="hero__facts">
          <li><Icon name="check" />Works on phone, tablet and computer</li>
          <li><Icon name="check" />Big pictures that stay showing</li>
          <li><Icon name="check" />Stop any time; nothing to fail</li>
        </ul>
      </div>
      <div class="hero__album" aria-hidden="true">
        {
          collage.map((id, i) => (
            <figure class={`print print--${i + 1}`}>
              <img src={pictureUrl(id)} alt="" width="220" height="220" fetchpriority={i === 0 ? 'high' : 'auto'} />
            </figure>
          ))
        }
        <p class="hero__note">“Two pictures of the teacup, together.”</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="games-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Play in your browser</p>
          <h2 id="games-title">Games you can play right now</h2>
          <p class="lede">Each one is calm, adult and quick to start. Choose one, sit side by side, and take turns tapping.</p>
        </div>
        <a class="btn" href="/games/">See all {GAMES.length} games <Icon name="arrow" /></a>
      </div>
      <ul class="card-grid">
        {featured.map((g) => <li><GameCard game={g} /></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--linen" aria-labelledby="how-title">
    <div class="container">
      <h2 id="how-title">How it works</h2>
      <ol class="steps">
        <li>
          <span class="steps__n">1</span>
          <h3>Pick something familiar</h3>
          <p>Pictures of teacups, gardens, pets and sailboats. No reading or rules to learn first.</p>
        </li>
        <li>
          <span class="steps__n">2</span>
          <h3>Sit side by side</h3>
          <p>Let them tap. Talk about the pictures. A mismatch simply waits for the next tap.</p>
        </li>
        <li>
          <span class="steps__n">3</span>
          <h3>Stop while it feels good</h3>
          <p>One game is a complete activity. “Done for now” is always on the screen.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="stage-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Beyond the screen</p>
          <h2 id="stage-title">Activity ideas for every stage</h2>
          <p class="lede">Music, everyday tasks, reminiscence and quiet sensory moments, adapted to what feels comfortable now.</p>
        </div>
        <a class="btn" href="/activities/ideas/">101 activity ideas <Icon name="arrow" /></a>
      </div>
      <ul class="stage-grid">
        <li>
          <GuideCard
            href="/activities/early-stage/"
            title="Early stage"
            text="Keep doing what they love, with small adjustments: hobbies, outings, word games and planning together."
            label="Early-stage ideas"
          />
        </li>
        <li>
          <GuideCard
            href="/activities/middle-stage/"
            title="Middle stage"
            text="Simple, familiar tasks broken into steps: folding, sorting, music, picture games and short walks."
            label="Middle-stage ideas"
          />
        </li>
        <li>
          <GuideCard
            href="/activities/late-stage/"
            title="Later stage"
            text="Comfort and connection through touch, sound and sight: hand care, favorite songs, photos and being together."
            label="Later-stage ideas"
          />
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--linen" aria-labelledby="approach-title">
    <div class="container approach">
      <div>
        <p class="eyebrow">Our approach</p>
        <h2 id="approach-title">A shared activity, not a memory test</h2>
        <p class="lede">
          Many “brain games” are built around speed, scores and streaks. For someone living with dementia that can feel
          like an exam. We built the opposite.
        </p>
        <a class="btn" href="/about/">Why we design it this way</a>
      </div>
      <ul class="principles">
        <li><Icon name="heart" /><div><h3>Nothing to fail</h3><p>No clock, score, lives or losing. A different picture is a pause, not a mistake.</p></div></li>
        <li><Icon name="eye" /><div><h3>Pictures stay showing</h3><p>Recognition over recall. Matching starts face up, so there is nothing to remember.</p></div></li>
        <li><Icon name="people" /><div><h3>Adult and dignified</h3><p>Warm, plain words and real-world pictures. Never cartoons or baby talk.</p></div></li>
        <li><Icon name="shield" /><div><h3>Private by design</h3><p>No accounts or ads. Your photos never leave your device.</p></div></li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="guides-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">For caregivers</p>
          <h2 id="guides-title">Practical guides for everyday care</h2>
        </div>
        <a class="btn" href="/caregiving/">All caregiving guides <Icon name="arrow" /></a>
      </div>
      <ul class="card-grid">
        <li><GuideCard href="/caregiving/how-to-play-together/" title="How to play games together" text="Set up, pace, and what to do when a game stops being fun." /></li>
        <li><GuideCard href="/caregiving/when-they-say-no/" title="When they say no to an activity" text="Common reasons for refusing, and gentle ways to try again later." /></li>
        <li><GuideCard href="/caregiving/tablets-and-screens/" title="Setting up a tablet" text="Larger text, fewer interruptions and a single simple home screen." /></li>
        <li><GuideCard href="/activities/printable/" title="Free printable activities" text="Large-print word searches, coloring pages, bingo and conversation cards." /></li>
      </ul>
      <aside class="research-band">
        <div>
          <h2>Brain health: what the research really says</h2>
          <p>
            Can dementia be prevented? Do brain games help? What about fasting, diet, sleep and hearing? Plain,
            sourced answers, including where the evidence is weak.
          </p>
        </div>
        <a class="btn" href="/brain-health/">Read the research guides</a>
      </aside>
    </div>
  </section>

  <section class="section section--linen" aria-labelledby="app-title">
    <div class="container app-band">
      <div>
        <p class="eyebrow">Also an app</p>
        <h2 id="app-title">Golden Moments on iPhone, iPad and Android</h2>
        <p>
          The free app works offline and can use family photos you choose, kept as copies on your device. Same calm
          design: four large tiles, no timer, no score.
        </p>
        <div class="btn-row">
          <a class="btn" href={SITE.appStoreUrl} rel="noopener"><Icon name="phone" />App Store</a>
          <a class="btn" href={SITE.playStoreUrl} rel="noopener"><Icon name="phone" />Google Play</a>
          <a class="btn btn--quiet" href="/app/">About the app</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <Faq items={faq} />
    </div>
  </section>

  <div class="container"><PlayCta /></div>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(1200px 500px at 85% 10%, rgb(255 224 138 / 55%), transparent 60%),
      radial-gradient(900px 400px at 0% 100%, rgb(234 223 203 / 70%), transparent 60%),
      var(--gm-background);
    border-bottom: 1px solid var(--gm-surface-sunken);
  }
  .hero__grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5.5rem);
  }
  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: 1.15fr 1fr;
    }
  }
  .hero h1 {
    font-size: var(--text-hero);
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin-bottom: var(--space-lg);
  }
  .hero .lede {
    margin-bottom: var(--space-xl);
    color: var(--gm-on-surface);
  }
  .hero__facts {
    list-style: none;
    padding: 0;
    margin: var(--space-xl) 0 0;
    display: grid;
    gap: var(--space-sm);
    font-size: var(--text-md);
  }
  .hero__facts li {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .hero__facts :global(svg) {
    color: var(--gm-success);
    flex: none;
  }
  .hero__album {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    max-width: 460px;
    margin-inline: auto;
    padding: var(--space-lg);
  }
  .print {
    margin: 0;
    padding: 12px 12px 30px;
    background: var(--gm-print-white);
    border-radius: 6px;
    box-shadow: var(--shadow-print);
    position: relative;
  }
  .print img {
    border-radius: 3px;
    width: 100%;
  }
  .print::before {
    content: '';
    position: absolute;
    top: -10px;
    left: 50%;
    width: 64px;
    height: 22px;
    transform: translateX(-50%) rotate(-3deg);
    background: rgb(255 224 138 / 75%);
    border: 1px solid rgb(201 146 0 / 25%);
  }
  .print--1 {
    transform: rotate(-4deg);
  }
  .print--2 {
    transform: rotate(3deg) translateY(18px);
  }
  .print--3 {
    transform: rotate(2deg) translateY(-6px);
  }
  .print--4 {
    transform: rotate(-3deg) translateY(12px);
  }
  .hero__note {
    position: absolute;
    left: 50%;
    bottom: -8px;
    transform: translateX(-50%) rotate(-1deg);
    margin: 0;
    padding: 10px 18px;
    background: var(--gm-on-surface);
    color: var(--gm-background);
    border-radius: var(--radius-md);
    font-size: var(--text-md);
    font-weight: 700;
    width: max-content;
    max-width: 92%;
    text-align: center;
    box-shadow: var(--shadow-raised);
  }
  @media (prefers-reduced-motion: no-preference) {
    .print {
      transition: transform var(--duration-normal) var(--ease-out);
    }
    .hero__album:hover .print--1 {
      transform: rotate(-6deg) translateY(-4px);
    }
    .hero__album:hover .print--2 {
      transform: rotate(5deg) translateY(10px);
    }
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }
  .section-head h2 {
    margin-bottom: var(--space-sm);
  }
  .section-head .lede {
    margin: 0;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: var(--space-xl) 0 0;
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    counter-reset: none;
  }
  .steps li {
    border-top: 3px solid var(--gm-on-surface);
    padding-top: var(--space-lg);
  }
  .steps__n {
    display: block;
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--gm-primary);
    margin-bottom: var(--space-md);
  }
  .steps p {
    color: var(--gm-on-surface-variant);
    margin: 0;
  }
  .approach {
    display: grid;
    gap: var(--space-2xl);
  }
  @media (min-width: 900px) {
    .approach {
      grid-template-columns: 1fr 1.2fr;
      align-items: start;
    }
  }
  .principles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }
  .principles li {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--gm-background);
    border: 1px solid var(--gm-outline);
    border-radius: var(--radius-lg);
  }
  .principles :global(svg) {
    flex: none;
    width: 32px;
    height: 32px;
    color: var(--gm-primary);
  }
  .principles h3 {
    font-size: var(--text-title-md);
    margin-bottom: var(--space-xs);
  }
  .principles p {
    margin: 0;
    color: var(--gm-on-surface-variant);
    font-size: var(--text-md);
  }
  .research-band {
    margin-top: var(--space-2xl);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    align-items: center;
    justify-content: space-between;
    padding: var(--space-xl);
    border-radius: var(--radius-xl);
    background: #eef5f8;
    border: 1px solid #c7dbe5;
    border-left: 8px solid var(--gm-secondary);
  }
  .research-band h2 {
    font-size: var(--text-title-lg);
    margin-bottom: var(--space-sm);
  }
  .research-band p {
    margin: 0;
    max-width: 44em;
  }
  .app-band {
    max-width: calc(var(--content-max) + 2 * var(--gutter));
  }
</style>
