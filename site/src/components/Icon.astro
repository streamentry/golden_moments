---
import { ICONS, type IconName } from '../lib/icons';
interface Props {
  name: IconName;
  class?: string;
  size?: number;
}
const { name, class: className, size = 24 } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={ICONS[name]}
/>
