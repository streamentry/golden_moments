---
import type { FaqItem } from '../lib/schema';
import { ui } from '../i18n/ui';
interface Props {
  items: readonly FaqItem[];
  title?: string;
  id?: string;
  lang?: string;
}
const { items, id = 'faq', lang = 'en' } = Astro.props;
const title = Astro.props.title ?? ui(lang).common.faqTitle;
---
<section aria-labelledby={id}>
  <h2 id={id}>{title}</h2>
  <div class="faq">
    {
      items.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <div>
            <p>{f.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>
