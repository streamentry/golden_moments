---
import Icon from './Icon.astro';
import { localizeHtml } from '../i18n/locales';
import { ui } from '../i18n/ui';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const t = ui(lang).healthNotice;
---
<aside class="notice" aria-label={t.aria}>
  <Icon name="info" />
  <div>
    <strong>{t.title}</strong>
    <p set:html={localizeHtml(lang, t.textHtml)} />
  </div>
</aside>
