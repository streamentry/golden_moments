---
export interface Crumb {
  href: string;
  label: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---
<nav class="breadcrumbs container" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {
      items.map((item, i) =>
        i === items.length - 1 ? (
          <li>
            <span aria-current="page">{item.label}</span>
          </li>
        ) : (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ),
      )
    }
  </ol>
</nav>
