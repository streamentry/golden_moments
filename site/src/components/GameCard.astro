---
import { pictureUrl } from '../data/pictures';
import type { GameInfo } from '../data/games';
import { localePath } from '../i18n/locales';
import { localStageHint } from '../i18n/games';
import { fill, ui } from '../i18n/ui';
interface Props {
  /** Already localized with `localizeGame`. */
  game: GameInfo;
  headingLevel?: 'h2' | 'h3';
  lang?: string;
}
const { game, headingLevel = 'h3', lang = 'en' } = Astro.props;
const H = headingLevel;
const t = ui(lang).cards;
---
<article class="card game-card">
  <div class="game-card__print">
    <div class="game-card__pics">
      {game.cardPictures.map((id) => <img src={pictureUrl(id)} alt="" width="120" height="120" loading="lazy" decoding="async" />)}
    </div>
  </div>
  <div class="card__body">
    <H><a class="card__link" href={localePath(lang, `/games/${game.slug}/`)}>{game.name}</a></H>
    <p>{game.short}</p>
    <ul class="tag-list" aria-label={t.aboutGame}>
      <li class="tag">{localStageHint(game.stages, lang)}</li>
      {game.printable && <li class="tag">{t.printable}</li>}
    </ul>
    <span class="card__more" aria-hidden="true">{fill(t.play, { name: lang === 'en' ? game.name.toLowerCase() : game.name })}</span>
  </div>
</article>
