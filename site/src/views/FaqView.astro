---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE } from '../lib/site';
import { localizeHtml } from '../i18n/locales';
import { PUBLISHED, fill, ui } from '../i18n/ui';
import Faq from '../components/Faq.astro';
import PlayCta from '../components/PlayCta.astro';
import { faqPage } from '../lib/schema';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = ui(lang);
const p = t.pages.faq;
const all = p.groups.flatMap((g) => g.items);
---
<PageLayout title={p.title} seoTitle={p.seoTitle} description={p.description} path="/faq/" crumb={p.crumb} lede={p.lede} jsonLd={[faqPage(all)]} lang={lang} available={PUBLISHED.map((l) => l.code)}>
  <nav aria-label={t.common.topics} class="toc">
    <ol>
      {p.groups.map((g) => <li><a href={`#${g.id}`}>{g.title}</a></li>)}
    </ol>
  </nav>
  {p.groups.map((g) => <Faq items={g.items} title={g.title} id={g.id} lang={lang} />)}
  <p set:html={localizeHtml(lang, p.moreHtml)} />
  <PlayCta slot="after" lang={lang} />
</PageLayout>
