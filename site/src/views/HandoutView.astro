---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE } from '../lib/site';
import { localizeHtml } from '../i18n/locales';
import { PUBLISHED, fill, ui } from '../i18n/ui';
import { GAME_BY_SLUG } from '../data/games';
import { localizeGame } from '../i18n/games';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const p = ui(lang).pages.handout;
const picks = ['picture-pairs', 'find-the-same', 'finish-the-saying', 'picture-puzzle', 'conversation-cards', 'coloring']
  .map((s) => GAME_BY_SLUG.get(s as Parameters<typeof GAME_BY_SLUG.get>[0]))
  .filter((g) => g !== undefined)
  .map((g) => localizeGame(g, lang));
---
<PageLayout title={p.title} seoTitle={p.seoTitle} description={p.description} path="/handout/" crumb={p.crumb} lede={p.lede} lang={lang} available={PUBLISHED.map((l) => l.code)}>
  <div class="handout-actions no-print">
    <button type="button" class="btn btn--primary" id="print-handout">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 6 2 18 2 18 9"></polyline>
        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
        <rect x="6" y="14" width="12" height="8"></rect>
      </svg>
      {p.crumb}
    </button>
  </div>
  <p class="handout-url">{SITE.domain}</p>
  <Fragment set:html={localizeHtml(lang, p.introHtml)} />
  <h2>{p.gamesTitle}</h2>
  <ul>
    {picks.map((g) => <li><strong>{g.name}.</strong> {g.short}</li>)}
  </ul>
  <Fragment set:html={localizeHtml(lang, p.restHtml)} />
</PageLayout>

<script>
  import { sounds } from '../games/shared/sound';
  document.getElementById('print-handout')?.addEventListener('click', () => {
    sounds.tap();
    window.print();
  });
</script>

<style>
  .handout-actions {
    margin-bottom: var(--space-md);
  }
  .handout-url {
    margin-block: var(--space-md);
    font-size: var(--text-h2);
    font-weight: 700;
    color: var(--gm-on-surface);
  }
  @media (prefers-contrast: more) {
    .handout-url {
      color: #000000;
      font-weight: 800;
    }
  }
  @media (forced-colors: active) {
    .handout-url {
      color: CanvasText;
    }
  }
</style>
