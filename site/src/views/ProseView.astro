---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE } from '../lib/site';
import { localizeHtml } from '../i18n/locales';
import { PUBLISHED, fill, ui } from '../i18n/ui';
import PlayCta from '../components/PlayCta.astro';

interface Props {
  lang: string;
  page: 'about' | 'editorial';
  path: string;
  updated?: string;
}
const { lang, page, path, updated } = Astro.props;
const p = ui(lang).pages[page];
const body = localizeHtml(lang, fill(p.bodyHtml, { email: SITE.supportEmail, domain: SITE.domain }));
const all = PUBLISHED.map((l) => l.code);
---
<PageLayout title={p.title} seoTitle={p.seoTitle} description={p.description} path={path} crumb={p.crumb} lede={'lede' in p ? (p.lede as string) : undefined} updated={updated} lang={lang} available={all}>
  <Fragment set:html={body} />
  {page === 'about' && <PlayCta slot="after" lang={lang} />}
</PageLayout>
