  "content": {
    "sayings": [
      {"start": "一寸光阴一寸", "end": "金", "others": ["银", "玉"], "prompt": "一天当中，您最喜欢哪段时光？"},
      {"start": "千里之行，始于", "end": "足下", "others": ["门前", "今日"], "prompt": "您喜欢散步吗？平时爱去哪里走走？"},
      {"start": "三人行，必有我", "end": "师", "others": ["友", "伴"], "prompt": "您跟谁学过一样手艺或本事？"},
      {"start": "百闻不如一", "end": "见", "others": ["看", "试"], "prompt": "有没有哪个地方，亲眼看到比听说的还要好？"},
      {"start": "家和万事", "end": "兴", "others": ["顺", "好"], "prompt": "您觉得一家人怎样才能和和睦睦？"},
      {"start": "有志者事竟", "end": "成", "others": ["通", "好"], "prompt": "有什么事是您下定决心做成的？"},
      {"start": "开卷有", "end": "益", "others": ["趣", "喜"], "prompt": "您喜欢读什么样的书或报纸？"},
      {"start": "一年之计在于", "end": "春", "others": ["秋", "冬"], "prompt": "春天来了，您最喜欢做什么？"},
      {"start": "一日之计在于", "end": "晨", "others": ["午", "夜"], "prompt": "早上起来，您喜欢先做什么？"},
      {"start": "瑞雪兆丰", "end": "年", "others": ["收", "景"], "prompt": "您喜欢下雪天吗？下雪时爱做些什么？"},
      {"start": "远亲不如近", "end": "邻", "others": ["亲", "友"], "prompt": "说说您喜欢的一位邻居吧。"},
      {"start": "众人拾柴火焰", "end": "高", "others": ["旺", "红"], "prompt": "家里有什么活儿，是大家一起干的？"},
      {"start": "路遥知马", "end": "力", "others": ["快", "壮"], "prompt": "您骑过马，或者近处看过马吗？"},
      {"start": "熟能生", "end": "巧", "others": ["花", "香"], "prompt": "有没有哪样拿手活，您做过很多很多遍？"},
      {"start": "种瓜得瓜，种豆得", "end": "豆", "others": ["花", "米"], "prompt": "您种过菜，或者养过花吗？"},
      {"start": "有朋自远方来，不亦", "end": "乐乎", "others": ["快哉", "美哉"], "prompt": "家里来客人时，您喜欢怎么招待？"},
      {"start": "一分耕耘，一分", "end": "收获", "others": ["欢喜", "汗水"], "prompt": "有什么事虽然辛苦，做完却觉得特别值得？"},
      {"start": "人逢喜事精神", "end": "爽", "others": ["好", "足"], "prompt": "最近有什么让您高兴的事？"},
      {"start": "心急吃不了热", "end": "豆腐", "others": ["包子", "馒头"], "prompt": "您喜欢吃豆腐吗？怎么做最好吃？"},
      {"start": "尺有所短，寸有所", "end": "长", "others": ["宽", "余"], "prompt": "您觉得自己最拿手的是什么？"},
