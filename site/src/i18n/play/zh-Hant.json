  "content": {
    "sayings": [
      {"start": "一寸光陰一寸", "end": "金", "others": ["銀", "玉"], "prompt": "一天當中，您最喜歡哪一段時光？"},
      {"start": "千里之行，始於", "end": "足下", "others": ["門前", "今日"], "prompt": "您喜歡散步嗎？平常喜歡去哪裡走走？"},
      {"start": "三人行，必有我", "end": "師", "others": ["友", "伴"], "prompt": "您跟誰學過一樣手藝或本事？"},
      {"start": "百聞不如一", "end": "見", "others": ["看", "試"], "prompt": "有沒有哪個地方，親眼看到比聽說的還要好？"},
      {"start": "家和萬事", "end": "興", "others": ["順", "好"], "prompt": "您覺得一家人怎樣才能和和氣氣？"},
      {"start": "有志者事竟", "end": "成", "others": ["通", "好"], "prompt": "有什麼事，是您下定決心做成的？"},
      {"start": "開卷有", "end": "益", "others": ["趣", "喜"], "prompt": "您喜歡看什麼樣的書或報紙？"},
      {"start": "一年之計在於", "end": "春", "others": ["秋", "冬"], "prompt": "春天來了，您最喜歡做什麼？"},
      {"start": "一日之計在於", "end": "晨", "others": ["午", "夜"], "prompt": "早上起來，您喜歡先做什麼？"},
      {"start": "遠親不如近", "end": "鄰", "others": ["親", "友"], "prompt": "說說您喜歡的一位鄰居吧。"},
      {"start": "路遙知馬", "end": "力", "others": ["快", "壯"], "prompt": "您騎過馬，或是近距離看過馬嗎？"},
      {"start": "熟能生", "end": "巧", "others": ["花", "香"], "prompt": "有沒有哪一樣拿手的事，您做過很多很多遍？"},
      {"start": "種瓜得瓜，種豆得", "end": "豆", "others": ["花", "米"], "prompt": "您種過菜，或是養過花嗎？"},
      {"start": "有朋自遠方來，不亦", "end": "樂乎", "others": ["快哉", "美哉"], "prompt": "家裡來客人的時候，您喜歡怎麼招待？"},
      {"start": "一分耕耘，一分", "end": "收穫", "others": ["歡喜", "汗水"], "prompt": "有什麼事雖然辛苦，做完卻覺得特別值得？"},
      {"start": "人逢喜事精神", "end": "爽", "others": ["好", "足"], "prompt": "最近有什麼讓您高興的事？"},
      {"start": "天下無難事，只怕有心", "end": "人", "others": ["情", "力"], "prompt": "有什麼事，是您很用心去做的？"},
      {"start": "車到山前必有", "end": "路", "others": ["橋", "道"], "prompt": "您喜歡坐車出去走走嗎？想去哪裡？"},
      {"start": "萬事起頭", "end": "難", "others": ["好", "早"], "prompt": "您學過的哪一樣本事，剛開始最不容易？"},
      {"start": "只要功夫深，鐵杵磨成", "end": "針", "others": ["刀", "釘"], "prompt": "您會做針線活嗎？家裡誰的手最巧？"},
      {"start": "冰凍三尺，非一日之", "end": "寒", "others": ["冷", "雪"], "prompt": "天氣冷的時候，您最喜歡做什麼？"},
      {"start": "近朱者赤，近墨者", "end": "黑", "others": ["白", "灰"], "prompt": "跟誰在一起的時候，您覺得最開心？"},
      {"start": "一回生，二回", "end": "熟", "others": ["好", "親"], "prompt": "和新朋友見面，您喜歡聊些什麼？"},
      {"start": "千里送鵝毛，禮輕情意", "end": "重", "others": ["濃", "深"], "prompt": "什麼樣的小禮物最讓您開心？"},
      {"start": "塞翁失馬，焉知非", "end": "福", "others": ["喜", "好"], "prompt": "有沒有一件事，開頭不太順，後來反而很好？"},
      {"start": "民以食為", "end": "天", "others": ["先", "本"], "prompt": "您最愛吃的一道家常菜是什麼？"},
      {"start": "飲水思", "end": "源", "others": ["泉", "河"], "prompt": "有誰幫過您，讓您一直心存感謝？"},
      {"start": "水滴石", "end": "穿", "others": ["開", "破"], "prompt": "您喜歡聽雨聲，或是溪水流過的聲音嗎？"},
      {"start": "一個好漢三個", "end": "幫", "others": ["友", "伴"], "prompt": "說說您的好朋友們吧。"},
      {"start": "不怕慢，只怕", "end": "站", "others": ["停", "等"], "prompt": "有什麼事，您喜歡慢慢來做？"},
      {"start": "花好月", "end": "圓", "others": ["明", "亮"], "prompt": "中秋節的時候，您家喜歡怎麼過？"},
      {"start": "授人以魚，不如授人以", "end": "漁", "others": ["網", "竿"], "prompt": "您喜歡釣魚，或是在河邊坐一坐嗎？"},
      {"start": "磨刀不誤砍柴", "end": "工", "others": ["時", "人"], "prompt": "做事之前，您喜歡先把東西準備好嗎？"},
      {"start": "三百六十行，行行出", "end": "狀元", "others": ["能人", "好手"], "prompt": "說說一份您喜歡做的工作吧。"},
      {"start": "酒香不怕巷子", "end": "深", "others": ["長", "遠"], "prompt": "您喜歡逛老街和小巷子嗎？"},
      {"start": "笑口常", "end": "開", "others": ["樂", "在"], "prompt": "什麼事最能讓您開懷大笑？"},
      {"start": "助人為快樂之", "end": "本", "others": ["源", "道"], "prompt": "有沒有哪一次幫了別人，讓您心裡很高興？"},
      {"start": "知足常", "end": "樂", "others": ["好", "安"], "prompt": "什麼樣的小事，會讓您覺得很滿足？"},
      {"start": "一言既出，駟馬難", "end": "追", "others": ["回", "留"], "prompt": "您欣賞什麼樣的人？"},
      {"start": "好的開始是成功的", "end": "一半", "others": ["一步", "起點"], "prompt": "您喜歡怎麼開始新的一天？"},
      {"start": "有緣千里來相", "end": "會", "others": ["見", "聚"], "prompt": "您和最好的朋友是怎麼認識的？"},
      {"start": "三個臭皮匠，勝過一個", "end": "諸葛亮", "others": ["劉備", "張飛"], "prompt": "遇到事情要商量的時候，您喜歡找誰一起想想？"},
      {"start": "船到橋頭自然", "end": "直", "others": ["停", "穩"], "prompt": "您坐過船嗎？喜歡在水邊做什麼？"},
      {"start": "讀萬卷書，行萬里", "end": "路", "others": ["山", "程"], "prompt": "您最想去哪個地方走走看看？"},
      {"start": "入境隨", "end": "俗", "others": ["意", "和"], "prompt": "去別的地方玩，您喜歡嚐嚐當地的什麼小吃？"},
      {"start": "好事成", "end": "雙", "others": ["對", "三"], "prompt": "最近有什麼好消息想跟大家分享嗎？"},
      {"start": "細水長", "end": "流", "others": ["青", "清"], "prompt": "您喜歡在河邊或溪邊散散步嗎？"},
      {"start": "情人眼裡出", "end": "西施", "others": ["美人", "仙女"], "prompt": "您覺得一年當中，哪個季節的風景最美？"},
      {"start": "欲速則不", "end": "達", "others": ["好", "成"], "prompt": "做什麼事的時候，您覺得慢慢來最好？"},
