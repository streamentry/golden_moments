      "description": "ཁྱིམ་ཚང་དང་ལྟ་སྐྱོང་བྱེད་མཁན་ཚོར་བློ་འཚབ་ཀྱི་ནད་པ་ལ་རིན་མེད་ཀྱི་པར་རིས་རྩེད་མོ་དང་། རྒྱབ་སྐྱོར་ཚོགས་པ་དང་ལྟ་སྐྱོང་བྱེད་པའི་ཐུམ་སྒྲིལ་གྱི་སྐོར་ལ་ཤོག་ངོས་གཅིག་གི་པར་སྐྲུན་བྱེད་ཐུབ་པའི་ཡིག་ཆ་ཞིག",
      "crumb": "དཔར་ཆོག་པའི་བཀྲམ།",
      "lede": "ཤོག་ངོས་འདི་རྒྱབ་སྐྱོར་ཚོགས་པ་དང་ལྟ་སྐྱོང་ཐུམ་སྒྲིལ་ཡང་ན་འཁྱགས་སྒམ་གྱི་སྒོ་ཆེད་དུ་པར་སྐྲུན་བྱོས། ཁྱེད་རང་གི་དྲ་ལྗོངས་ཀྱི་པར་སྐྲུན་བཀའ་ཚིག་བེད་སྤྱོད་བྱེད། དཀར་ཆག་དང་མཐེབ་གཞོང་རྣམས་པར་ཤུས་ལས་ལྷག་ཡོད།",
      "introHtml": "<p>པར་རིས་ཆེན་པོ་དང་། ཚིག་གཙང་མ། གང་ཡང་འཐུས་ཤོར་མེད། ཁ་པར་དང་། ཐབ་ཚང་། ཡང་ན་གློག་ཀླད་ཐོག་ལ་རིན་མེད་ཡིན། མིང་ཐོ་འགོད་མི་དགོས། ཁྱབ་བསྒྲགས་མེད། དུས་ཚོད་མེད་ལ། སྐར་མ་མེད། ཕན་ཚུན་བསྡད་དེ་རེས་མོས་ཀྱིས་བསྡད།</p>",
      "gamesTitle": "མཉམ་དུ་ཚོད་ལྟ་བྱེད་པའི་རྩེད་མོ།",
      "restHtml": "<h2>བསླབ་བྱ་ཁ་ཤས།</h2><ul><li>མི་དེ་ཡག་ཤོས་ཡོད་པའི་དུས་ཚོད་འདེམས།</li><li>སྒྲིག་སྟངས་སྟབས་བདེ་ཤོས་ནས་འགོ་བཙུགས། རྡོ་གཡམ་བཞི་ནི་མང་པོ་འདུག</li><li>པར་རིས་སྐོར་ལ་སྐད་ཆ་བཤད། ཁ་བརྡ་ནི་རྒྱུན་དུ་ཆ་ཤས་ཡག་ཤོས་དེ་རེད།</li><li>ད་དུང་སྐྱིད་པོ་ཡོད་པའི་སྐབས་སུ་མཚམས་འཇོག་དགོས། སྔ་མོ་ནས་མཇུག་སྒྲིལ་བ་ནི་གྲུབ་འབྲས་ཡག་པོ་ཞིག་རེད།</li></ul><h2>དྲ་ཚིགས་སྟེང་དུའང་།</h2><ul><li>རིན་མེད་པར་ཤུས་བྱེད་ཐུབ་པ། པར་ཤུས་ཆེ་བའི་ཚིག་འཚོལ་ཞིབ། ཚོན་བཏང་བའི་ཤོག་ངོས། ཁ་བརྡའི་ཤོག་བྱང་། པར་རིས་བིང་གོ།</li><li>གོ་རིམ་རེ་རེའི་ཆེད་དུ་བྱེད་སྒོའི་བསམ་གཞིག་དང་། མཉམ་དུ་རྩེད་མོ་རྩེ་བ་དང་རང་ཉིད་ལ་ལྟ་རྟོག་བྱེད་པའི་ལམ་སྟོན།</li></ul><p class=\"muted\">མཉམ་དུ་སྤྲོ་སྣང་དང་དུས་ཚོད་ཀྱི་ཆེད་དུ། སྨན་པའི་བསླབ་བྱ་དང་། བརྟག་དཔྱད་ཡང་ན་སྨན་བཅོས་མིན། གསེར་གྱི་དུས་སྐབས་ནི་Cloudjet Solutions Pte ཡིས་པར་སྐྲུན་བྱས། Ltd.</p>"
    },
    "organizations": {
      "title": "ལྟ་སྐྱོང་ཁང་དང་དཔེ་མཛོད་ཁང་དང་རྒྱབ་སྐྱོར་ཚོགས་པའི་ཆེད་དུ།",
      "seoTitle": "སྨན་བཅོས་ཁང་དང་སྡེ་ཚན་ཁག་ལ་རིན་མེད་བློ་འཚབ་ནད་ཀྱི་བྱ་འགུལ།",
      "description": "ང་ཚོའི་སྨན་ཁང་དང་། རྒན་རྒོན་གྱི་ཉིན་མོའི་ལས་རིམ། དཔེ་མཛོད་ཁང་། རྒན་རྒོན་གྱི་ལས་ཁུངས། རྒྱབ་སྐྱོར་ཚོགས་པ་ཁག་གིས་ང་ཚོའི་རིན་མེད་ཀྱི་བློ་འཚབ་ཀྱི་རྩེད་མོ་དང་།",
      "crumb": "ཚོགས་པ་ཁག་གི་ཆེད་དུ།",
      "lede": "དྲ་ཚིགས་འདིའི་སྟེང་གི་དངོས་པོ་ཚང་མ་གནས་སྡོད་པ་དང་། ཚོགས་མི། ཚོང་ཤག་བཅས་དང་མཉམ་དུ་རིན་མེད་དུ་བེད་སྤྱོད་གཏོང་ཐུབ། ཤོག་ངོས་འདིས་འདིར་གང་ཡོད་པ་དང་དེ་གང་འདྲ་བྱས་ནས་བརྗེ་རེས་བྱེད་དགོས་མིན་འགྲེལ་བཤད་རྒྱག་ཡོད།",
      "shortText": "{name}: བློ་འཚབ་ཅན་གྱི་མི་དང་ཁོང་ཚོའི་ལྟ་སྐྱོང་བྱེད་མཁན་ཚོར་རིན་མེད་ཀྱི་པར་རིས་རྩེད་མོ་དང་བྱེད་སྒོའི་ལམ་སྟོན། མིང་ཐོ་འགོད་མི་དགོས། དུས་ཚོད་མེད་པ། སྐར་གྲངས་མེད།",
      "longText": "{name} ({domain}) འབུལ་བ། {count} བློ་འཚབ་ཀྱི་ནད་པ་ལ་རིན་མེད་ཀྱི་དྲ་ཚིགས་རྩེད་མོ་བཟོས་ཡོད། དེའི་ནང་པར་རིས་ལྷག་མ་ཡོད་པའི་ཆ་གཅིག་མཐུན་སྒྲིག་དང་། རྩིས་ཁྲ་དང་། ཁྱབ་བསྒྲགས། དུས་ཚོད། སྐར་གྲངས་བཅས་མེད། དྲ་ཚིགས་དེ་ལ་ད་དུང་བློ་འཚབ་ཀྱི་རིམ་པ་རེ་རེའི་ཆེད་དུ་སྐད་ཡིག་གསལ་པོའི་བྱེད་སྒོའི་ལམ་སྟོན་ཡོད་ཅིང་།",
      "useTitle": "ཚོགས་པ་གང་ཞིག་གིས་བེད་སྤྱོད་གཏོང་ཐུབ་ཀྱི་ཡོད་པ།",
      "gamesItemHtml": "<strong>{count} དྲ་རྒྱའི་རྩེད་མོ།</strong> གློག་ཀླད་ལ་མཐུད་པའི་གློག་ཀླད་དང་། ཐབ་ཚང་། ཡང་ན་བརྙན་འཕྲིན་ཐོག་ལ་ལས་ཀ་བྱེད་ཀྱི་ཡོད། གཞི་བཙུགས་དང་། རྩིས་ཁྲ། ཕབ་ལེན་བྱེད་མི་ཆོག དམ་པའི་མངའ་དབང <a href=\"/games/\">རྩེད་མོ་ཚང་མ།</a>.",
      "printablesLabel": "{count} པར་ཤུས་བྱེད་ཐུབ་པ།",
      "printablesAfter": "ཤོག་ངོས་རེ་རེའི་སྟེང་གི་པར་སྐྲུན་མཐེབ་བེད་སྤྱོད་བྱེད།",
      "moreItemsHtml": "<li><strong>སྡེ་ཚན་གྱི་རྣམ་གཞག</strong> <a href=\"/games/picture-bingo/\">པར་རིས་བིང་གོ།</a> པར་ཤུས་བྱེད་ཐུབ་པའི་ཤོག་བྱང་དང་གློག་བརྙན་ཐོག་ཁ་པར་གཏོང་མཁན་ཡོད། <a href=\"/activities/trivia/\">ལས་སླ་བོ།</a> ལན་འདེམ་དང་གླེང་མོལ་གྱི་གནད་དོན་ཡོད་པའི་དྲི་བ་༥༠ཡོད།</li><li><strong>བྱ་བའི་ལམ་སྟོན།</strong> ལས་བྱེད་པ་དང་ཁྱིམ་ཚང་ལ་གོ་རིམ་དང་རིགས་ལྟར་སྐད་ཡིག་གསལ་པོའི་ཐོག་ནས་ཐོན་ཁུངས་དང་ལྷན་དུ་བྲིས་ཡོད། ནས་འགོ་བརྩམས། <a href=\"/activities/ideas/\">བྱ་འགུལ་གྱི་བསམ་གཞིག101།</a> ཡང་ན <a href=\"/activities/care-home-groups/\">རྒན་གསོ་ཁང་ལ་སྡེ་ཚན་གྱི་བྱེད་སྒོ།</a>.</li>",
      "restHtml": "<h2>སྡེ་ཚན་ཁག་གིས་བེད་སྤྱོད་གཏོང་སྟངས།</h2><ul><li><strong>བདག་སྐྱོང་ཁང་དང་དྲན་ཤེས་བདག་སྐྱོང་།</strong> བིང་གོ་པར་རིས་ཡང་ན་སྤྱིར་བཏང་གི་ཁང་པའི་བརྙན་འཕྲིན་ཐོག་ལ་སྐད་ཆ་མཇུག་སྒྲིལ་བ་དང་། མི་གཅིག་གིས་སྡེ་ཚན་གྱི་ཆེད་དུ་བརྡུང་བ་རེད།</li><li><strong>རྒན་རྒོན་གྱི་ཉིན་མོའི་ལས་རིམ།</strong> གཅིག་ནས་གཅིག་གི་དུས་ཚོད་ཐུང་ཐུང་ཆེད་དུ་པར་རིས་ཆ་གཅིག་བཞི་ལ་སྒྲིག་པའི་ཐབ་ཚང་གི་ས་ཚིགས་ཤིག</li><li><strong>སྤྱི་པའི་དཔེ་མཛོད་ཁང་།</strong> དྲན་ཤེས་ཆས་ནང་དུ་པར་སྐྲུན་བྱས་པའི་ཚིག་འཚོལ་ཞིབ་དང་ཁ་བརྡའི་ཤོག་བྱང་དང་། དཔེ་མཛོད་ཀྱི་ཐབ་ཚང་ནང་དུ་དྲ་ཚིགས་དེ་དེབ་མཚོན་བྱས་ཡོད།</li><li><strong>ལྟ་སྐྱོང་བྱེད་མཁན་གྱི་རྒྱབ་སྐྱོར་ཚོགས་པ་དང་དྲན་ཤེས་ཟ་ཁང་།</strong> ཅིག <a href=\"/handout/\">ཤོག་ངོས་གཅིག་ཅན་གྱི་དཔར་ཆོག་པའི་བཀྲམ།</a> ཁྱིམ་ཚང་ཚོས་ཁྱིམ་དུ་བསྐྱལ་ཆེད།</li><li><strong>སྨན་ཁང་དང་ཕྱིར་འབུད་འཆར་གཞི་བཟོ་མཁན།</strong> ཁྱིམ་དུ་ཡང་ན་ཉལ་ཁྲིའི་ཉེ་འགྲམ་དུ་ལས་ཀ་ལྷོད་པོ་བྱེད་པའི་ཆེད་དུ་ལྟ་སྐྱོང་བྱེད་མཁན་གྱི་ཐུམ་སྒྲིལ་ནང་དུ་ཡོད་པའི་ཡིག་ཆ་དེ་སྤྲོད་དགོས།</li></ul><h2>ང་ཚོས་གང་མི་བྱེད་པ།</h2><p>རྩེད་མོ་དེ་དག་ནི་སྤྲོ་སྣང་དང་དུས་ཚོད་མཉམ་དུ་གཏོང་བའི་ཆེད་དུ་ཡིན། དེ་དག་གིས་ནད་རྟགས་བརྟག་དཔྱད་དང་། བརྟག་དཔྱད། སྐར་གྲངས། སྨན་བཅོས་བྱེད་པའམ་ཡང་ན་མགྱོགས་པོ་བཟོ་མི་ཐུབ། ང་ཚོས་ཚོགས་པ་ཁག་ལ་དེ་དག་དེ་ལྟར་བརྗོད་མི་དགོས་པའི་འབོད་སྐུལ་བྱེད་ཀྱི་ཡོད། ཁྱབ་བསྒྲགས་མེད་པ་དང་། རྩེད་མོ་དེ་དག་གིས་མིང་དང་། འཕྲོད་བསྟེན་གྱི་ཞིབ་ཕྲ། ཡང་ན་པར་བླུགས་དགོས་པའི་འདྲི་རྩད་བྱེད་ཀྱི་མེད། དྲ་ཚིགས་འདིས་གུ་གུལ་དབྱེ་ཞིབ་བེད་སྤྱད་དེ་ཕེབས་མཁན་རྩིས་རྒྱག་བྱེད་ཀྱི་ཡོད། ང་ཚོའི <a href=\"/privacy/\">གསང་བའི་གསལ་བསྒྲགས།</a> དེས་བསྡུ་རུབ་བྱེད་པའི་དངོས་པོ་འགྲེལ་བཤད་བྱེད། 2016ལོར་བེད་སྤྱོད་བྱས་པའི་པར་རིས། <a href=\"/games/photo-pairs/\">པར་ཆ་གཉིས།</a> དྲ་ལྗོངས་ནང་དུ་བསྡད་རོགས།</p><h2>ང་ཚོ་ཁྱེད་རང་གི་ཐོན་ཁུངས་ཐོ་གཞུང་ནང་ཁ་སྣོན་བྱོས།</h2><p>གལ་ཏེ་ཁྱེད་ཀྱིས་ལྟ་སྐྱོང་བྱེད་མཁན་གྱི་ཐོན་ཁུངས་ཐོ་གཞུང་ཞིག་ཉར་ཚགས་བྱས་ན། <a href=\"/\">{domain}</a>. ཁྱོད་ཀྱིས་འགྲེལ་བཤད་གང་རུང་ཞིག་འདྲ་བཤུས་བྱེད་ཐུབ།</p>",
      "shortTitle": "གསལ་བཤད་མདོར་བསྡུས།",
      "longTitle": "འགྲེལ་བཤད་རིང་བ།",
      "linksHtml": "<p>ཐད་ཀར་འབྲེལ་མཐུད་བྱེད་པའི་ཕན་ཐོགས་པའི་ཤོག་ངོས། <a href=\"/games/\">རིན་མེད་རྩེད་མོ།</a>, . <a href=\"/activities/printable/\">རིན་མེད་པར་ཤུས་བྱེད་ཐུབ་པ།</a>, . <a href=\"/activities/alzheimers/\">ཨལ་ཛེ་མར་ནད་ཀྱི་བྱ་འགུལ།</a> དང་ <a href=\"/caregiving/how-to-play-together/\">མཉམ་དུ་རྩེད་སྟངས།</a>.</p><h2>དྲི་བའམ་ནོར་བཅོས་བྱེད་པ།</h2><p>གལ་ཏེ་དྲ་ཚིགས་སྟེང་གི་དངོས་པོ་གང་ཞིག་ནོར་འཁྲུལ་ཅན་དང་གསལ་པོ་མེད་པའམ་ཡང་ན་གནས་སྡོད་པ་ཞིག་གི་དགོས་མཁོ་འདིར་ཡོད་པའི་དངོས་པོ་དེས་སྐོང་མི་ཐུབ་ན། <a href=\"mailto:{email}\">{email}</a>. སྐུ་མཁྱེན། སྡོད་དམངས་དང་ཚོང་ཤག་གི་སྒེར་གྱི་ཆ་འཕྲིན་དང་འཕྲོད་བསྟེན་ཆ་འཕྲིན་མ་བསྐུར་རོགས།</p>"
    },
    "app": {
      "title": "གསེར་གྱི་དུས་སྐབས་མཉེན་ཆས།",
      "seoTitle": "ཀུ་ཤུ་དང་ཨན་ཌོར་གྱི་གསེར་གྱི་དུས་སྐབས་མཉེན་ཆས།",
      "description": "གསེར་གྱི་དུས་སྐབས་རིན་མེད་ཀྱི་མཉེན་ཆས། པར་རིས་འཇམ་པོ་བཞི་དང་མཉམ་དུ་མཐུན་སྒྲིག་བྱེད་པ་དང་། ཁྱེད་ཀྱི་ཐབས་འཕྲུལ་སྟེང་ལ་ཉར་བའི་ཁྱིམ་ཚང་གི་པར་རིས།",
      "crumb": "མཉེན་ཆས་དེ།",
      "lede": "ཁྱེད་རང་གིས་དྲ་ཚིགས་འདིའི་སྐོར་ལ་དགའ་པོ་ཡོད་པའི་དངོས་པོ་ཚང་མ་དྲ་རྒྱའི་ཕྱི་རོལ་དུ་ལས་ཀ་བྱེད་པའི་མཉེན་ཆས་ནང་དུ་ཡོད་པ་དང་། ཁྱེད་རང་གིས་འདེམས་པའི་ཁྱིམ་ཚང་གི་པར་བེད་སྤྱོད་གཏོང་ཐུབ།",
      "worksOn": "ལ་ལས་ཀྱིས། {platforms} ({requirements}).",
      "bodyHtml": "<h2>ཆུང་ངུའི་འགོ་བརྩམས།</h2><p>རྡོ་གཡམ་ཆེན་པོ་བཞི་དང་གོམས་འདྲིས་ཡོད་པའི་རི་མོ་ནས་མགོ་བརྩམས། པར་རིས་མཐོང་ཐུབ་པ་བྱ་དགོས། ཡང་ན་བདེ་པོ་ཡོད་པའི་སྐབས་སུ་སྦས་དགོས། འཇམ་པོའི་ཐབས་ལམ་ལ་དུས་ཚོད་དང་། སྐར་གྲངས། ཡང་ན་ཉེས་ཆད་མེད། 4, 6, 8 ཡང་ན་ 12 འདེམས།</p><h2>སྒེར་ལ་བཟོས།</h2><p>ཁྱེད་རང་གི་འཕྲུལ་ཆས་ཀྱི་པར་འདེམས་མཁན་གྱིས་ནང་མིའི་པར་འདེམས། མཉེན་ཆས་དེས་བྱེད་སྒོའི་ཆེད་དུ་འདྲ་བཤུས་ཆུང་ཆུང་ཉར་ཚགས་བྱེད་ཀྱི་ཡོད། ཁྱེད་ཀྱི་དཔེ་མཛོད་ལ་པར་བཤུས་བྱེད་མི་ཐུབ་པའམ་ཡང་ན་ཁྱེད་ཀྱི་པར་ཐོག་མ་བསྒྱུར་མི་ཐུབ་པ་དང་། བསྡུ་སྒྲིག་གཅིག་ནང་པར་༢༤ བར་ཉར་ཐུབ།</p><h2>མཉམ་དུ་ལྟོས་དང་།</h2><p>དུས་གཅིག་ཏུ་པར་རིས་གཅིག་ལ་གཟིགས། འདམ་ཀའི་བརྡ་སྟོན་གྱིས་མི་སུ་ལ་ཡང་མིང་དྲན་དགོས་པའམ་ལན་ཡང་དག་མ་སྤྲོད་པར་ཁ་བརྡ་བྱེད་པར་གདན་འདྲེན་ཞུ་གི་ཡོད། བལྟས་པ་ཙམ་གྱིས་ཆོག</p><h2>གལ་གནད་ཆེ་བའི་ས་ཆར་དྲ་རྒྱའི་ཕྱི་རོལ་དུ།</h2><p>འགོ་འཛུགས་པར་རིས་དང་པར་རིས་ཐུམ་སྒྲིལ་བརྒྱད་ཚང་མ་མཉེན་ཆས་ནང་དུ་ཚུད་ཡོད། ནང་འདྲེན་བྱས་པའི་པར་རིས་འདྲ་བཤུས་དྲ་རྒྱའི་ཕྱི་རོལ་དུ་ལས་ཀ་བྱེད་ཀྱི་ཡོད། དྲ་རྒྱའི་མཐུད་ཁང་དེ་iCloudནང་དུ་གསོག་འཇོག་བྱས་པའི་ཐོག་མའི་ཡིག་ཆ་འདེམས་པར་དྲ་རྒྱའི་མཐུད་ཁ་དགོས་ངེས་ཡིན།</p><h2>རྩིས་ཁྲ་མེད་ལ། པར་མཉམ་སྒྲིག་སར་བར་མེད།</h2><p>ཁྱིམ་ཚང་གི་པར་རིས་འདྲ་བཤུས་དེ་འཕྲུལ་ཆས་སྟེང་གི་མཉེན་ཆས་ནང་དུ་གནས་ཡོད། ཁྱེད་ཀྱིས་འདྲ་བཤུས་དེ་དག་ཐོག་མ་མ་བསུབས་པར་མེད་པར་བཟོ་ཐུབ། ཡོ་ཆས་རྒྱབ་ལྗོངས་ནང་མཉེན་ཆས་ཀྱི་གྲངས་ཐོ་ཚུད་སྲིད། ཀློག་པ། <a href=\"/app-privacy/\">མཉེན་ཆས་ཀྱི་གསང་སྤྱོད་སྲིད་ཇུས།</a>, དང <a href=\"/help/\">མཉེན་ཆས་རོགས་རམ།</a> གོམ་པ་རེ་རེ་བཞིན་གོམ་པ་རྒྱག་དགོས།</p>",
      "disclaimer": "གསེར་གྱི་དུས་སྐབས་ནི་སྤྲོ་སྐྱིད་དང་མཉམ་སྤྱོད་ཀྱི་ཁ་བརྡའི་ཆེད་དུ་ཡིན། དེས་བློ་འཚབ་ནད་དང་ཨལ་ཛེ་མར་ནད་ཀྱི་བརྟག་དཔྱད་དང་། སྨན་བཅོས། སྔོན་འགོག ཡང་ན་ཚད་འཇལ་བྱེད་ཀྱི་མེད།",
