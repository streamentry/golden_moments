  "pages": {
    "about": {
      "title": "མཉམ་སྤྱོད་ཀྱི་བྱ་འགུལ་ཞིག དྲན་ཤེས་ཚོད་ལྟ་མིན།",
      "seoTitle": "གསེར་གྱི་དུས་སྐབས་སྐོར། ང་ཚོའི་ཐབས་ལམ།",
      "description": "གསེར་གྱི་དུས་སྐབས་ཀྱི་རྩེད་མོ་ལ་དུས་ཚོད་དང་། སྐར་གྲངས། ཡང་ན་ཐིག་རིས་མེད་པ་གང་ཡིན་ནམ། པར་རིས་དེ་དག་གང་ཡིན་ནམ། དེ་བཞིན་ང་ཚོས་བློ་འཚབ་ཀྱི་ནད་གཞིའི་སྐོར་ལ་གང་བརྗོད་རྒྱུ་ཡིན་པ་དང་།",
      "crumb": "ང་ཚོའི་ཐབས་ལམ།",
      "lede": "གསེར་གྱི་དུས་སྐབས་འདིས་ལྟ་སྐྱོང་བྱེད་མཁན་དང་བློ་འཚབ་ཀྱི་ནད་པ་གཅིག་གིས་མཉམ་དུ་སྤྱོད་ཐུབ་པའི་ཞི་འཇམ་དང་རྒན་རྒོན་གྱི་པར་རིས་བྱེད་སྒོ་བཟོ་གི་ཡོད།",
      "bodyHtml": "<h2>ང་ཚོས་ཡིད་ཆེས་བྱེད་པ།</h2><p>བྱ་འགུལ་གྱི་དམིགས་ཡུལ་ནི་དུས་ཚོད་དེ་རང་ཡིན། ཁ་བརྡ་དང་། འཛུམ་མདངས་། པར་གཉིས་མཉམ་དུ་བཞག་པའི་ཡིད་ཚིམས། ཡང་ན་ཉེ་འགྲམ་དུ་བསྡད་པ་ཙམ་ཡིན། འདི་ནི་མི་གཞན་ལ་ཚད་འཇལ་རྒྱུ་དང་། ཁོང་ཚོར་སྔར་ལས་སྐུལ་འདེད་གཏོང་རྒྱུ། ཡང་ན་གང་ཡང་བདེན་དཔང་བྱེད་རྒྱུ་མིན།</p><p>ཀླད་པའི་སྦྱོང་བརྡར་གྱི་མཉེན་ཆས་མང་པོ་ཞིག་མགྱོགས་ཚད་དང་། སྐར་གྲངས། ཐིག་རིས། རིམ་པ་བཅས་ལ་གཞི་བཅོལ་ནས་བཟོས་ཡོད། བློ་འཚབ་ཀྱི་ནད་གཞི་ཡོད་པའི་མི་ལ་ཁོང་ཚོས་རྒྱུགས་འཕྲོད་མི་ཐུབ་པའི་ཡིག་རྒྱུགས་ལྟ་བུའི་ཚོར་བ་སྟེར་ཐུབ། ང་ཚོས་ལྡོག་ཕྱོགས་ནས་བཟོ་བཀོད་བྱས་པ་དང་། ང་ཚོས་ཁྲིམས་ལུགས་འདི་དག་ལ་དམ་འཛིན་བྱེད་ཀྱི་ཡོད།</p><ul><li><strong>འཐུས་ཤོར་གང་ཡང་མེད།</strong> ཆུ་ཚོད་དང་། སྐར་གྲངས། བགྲང་ཆས། མི་ཚེ། ཐིག་རིས། བརྙན་ཤེལ་ཡང་ན་བགྲང་ཆས། གློག་བརྙན་གང་རུང་ཞིག་ལ་མེད།</li><li><strong>དྲན་གསོ་ལས་ངོས་འཛིན།</strong> པར་རིས་རྣམས་སྔོན་སྒྲིག་ལྟར་སྟོན་གྱི་ཡོད། བརྡ་སྟོན་གྱིས་ཁ་བརྡ་གདན་འདྲེན་ཞུས་པ་དང་མིང་དང་དྲན་ཤེས་ནམ་ཡང་དྲི་བ་དྲིས་ལན་མ་བྱེད།</li><li><strong>ཆེན་པོ་དང་། གཙང་མ། བརྟན་པོ།</strong> ཡིག་ཆ་དང་པར་རིས་ཆེ་བ་དང་། ཁྱད་པར་མཐོ་བ། དེ་བཞིན་ས་ཆ་གཅིག་ཏུ་གནས་པའི་ཚོད་འཛིན་བཅས་ཡིན།</li><li><strong>རྒན་རྒོན་གྱི་ཆེ་མཐོང་།</strong> དངོས་ཡོད་ཀྱི་པར་རིས་དང་ཁ་གསལ་དང་ཚིག་དྲོ་པོ། འགུལ་བརྙན་དང་། གླུ་དབྱངས་བསྟོད་པ། ཡང་ན་ཨི་མོ་ཇི་བྱ་དགའ་མེད།</li><li><strong>ཐར་ལམ་སྟབས་བདེ་ཞིག</strong> “ད་ལྟའི་ཆེད་དུ་བྱས་ཟིན་”ཞེས་པ་དེ་རྟག་ཏུ་མཐོང་རྒྱུ་ཡོད། ལམ་ཕྱེད་མཚམས་འཇོག་པ་ནི་གྲུབ་འབྲས་ཡག་པོ་ཞིག་རེད།</li><li><strong>སྔོན་སྒྲིག་ལྟར་སྒེར་གྱི་ཡིན།</strong> རྩིས་ཁྲ་དང་ཁྱབ་བསྒྲགས་མེད། ཁྱེད་ཀྱིས་འདེམས་པའི་པར་རིས་རྣམས་ཁྱེད་ཀྱི་ཡོ་ཆས་སྟེང་དུ་བསྡད་ཡོད།</li></ul><h2>ང་ཚོས་གང་ཞིག་རྩོད་ལེན་བྱེད་ཀྱི་མེད།</h2><p>ང་ཚོའི་རྩེད་མོ་ནི་སྤྲོ་སྣང་དང་འབྲེལ་མཐུད་ཆེད་དུ་ཡིན། དེ་དག་གིས་ནད་རྟགས་བརྟག་དཔྱད་དང་། བརྟག་དཔྱད། ཚད་འཇལ། སྨན་བཅོས་བྱེད་པ། ང་ཚོས་ཞིབ་འཇུག་སྐོར་འབྲི་སྐབས། <a href=\"/brain-health/\">ཀླད་པའི་འཕྲོད་བསྟེན་ཤོག་ངོས།</a>ང་ཚོས་མངོན་གསལ་དེ་གང་དུ་ཞན་པོ་ཡོད་མེད་གསལ་པོ་བཤད་ཀྱི་ཡོད། ང་ཚོས་དེ་རང་ཉིད་ཀྱི་རྩེད་མོ་དང་འབྲེལ་བ་བྱེད་ཀྱི་མེད།</p><h2>ང་ཚོ་སུ་རེད།</h2><p>གསེར་གྱི་དུས་སྐབས་ནི་རང་དབང་ཅན་གྱི་རུ་ཁག་ཆུང་ཆུང་ཞིག་ཡིན། ང་ཚོ་སྨན་པ་མིན། ང་ཚོའི་ལམ་སྟོན་དེ་ཚོ་རྒྱལ་ཡོངས་རྒས་ཚད་ཀྱི་ཞིབ་འཇུག་ལྟེ་གནས་དང་ཨལ་ཛེ་མར་གྱི་ཚོགས་པ་སོགས་ཚོགས་པ་ཁག་གིས་པར་སྐྲུན་བྱས་པའི་ལམ་སྟོན་ལས་བྲིས་པ་དང་། ཀློག་པ <a href=\"/editorial-policy/\">ང་ཚོས་ཤོག་བུ་འབྲི་སྟངས་དང་ཞིབ་བཤེར་བྱེད་སྟངས།</a>.</p><h2>ང་ཚོར་ག་རེ་ཕན་ཐོགས་ཡོད་མེད་བཤད་རོགས།</h2><p>ཁྱེད་རང་ལ་གང་ཕན་ཐོགས་ཡོད་མེད་དང་། ལྷག་པར་དུ་བློ་འཚབ་ཀྱི་ནད་གཞི་ཡོད་པའི་མི་དང་། ཁྱིམ་ཚང་གི་ལྟ་སྐྱོང་བྱེད་མཁན། གློག་འཕྲིན། <a href=\"mailto:{email}\">{email}</a>.</p>"
    },
    "editorial": {
      "title": "ང་ཚོས་ཤོག་ངོས་འབྲི་སྟངས་དང་ཞིབ་བཤེར་བྱེད་སྟངས།",
      "seoTitle": "རྩོམ་སྒྲིག་སྲིད་ཇུས།",
      "description": "གསེར་གྱི་དུས་སྐབས་ཀྱིས་ཞིབ་འཇུག་དང་། བྲིས། འབྱུང་ཁུངས། དེའི་བློ་འཚབ་ཀྱི་བྱ་འགུལ་དང་ཀླད་པའི་འཕྲོད་བསྟེན་གྱི་ཤོག་ངོས་གསར་བརྗེ་བྱེད་སྟངས། ང་ཚོས་ནམ་ཡང་པར་སྐྲུན་བྱེད་ཀྱི་མེད།",
      "crumb": "རྩོམ་སྒྲིག་སྲིད་ཇུས།",
      "bodyHtml": "<h2>ང་ཚོའི་ཡོང་ཁུངས།</h2><p>ང་ཚོའི་ལམ་སྟོན་ནི་རྒྱལ་ཡོངས་རྒན་རྒོན་ལྟེ་གནས་དང་། CDC། ཨལ་ཛེ་མར་ཚོགས་པ། ཨ་རིའི་ཨལ་ཛེ་མར་ཐེབས་རྩ་ཁང་། ཁྱིམ་ཚང་ལྟ་སྐྱོང་མནའ་འབྲེལ་དང་NHSསོགས་ཚོགས་པ་ཁག་གི་སྤྱི་དམངས་ཀྱི་ལམ་སྟོན་ལ་གཞི་བཅོལ་ཡོད། ལམ་སྟོན་ཚང་མས་བརྟེན་སའི་ཐོན་ཁུངས་ཐོ་འགོད་བྱས་ཡོད། ང་ཚོས་ཐོན་ཁུངས་རེ་རེ་ལ་ཁུངས་གཏུགས་མ་བྱེད་གོང་ཁ་ཕྱེ་བ་དང་། དེས་དངོས་གནས་གང་བཤད་པ་དེ་རྐྱངམ་གཅིག་སྙན་ཞུ་བྱེད་ཀྱི་ཡོད།</p><h2>ང་ཚོས་འབྲི་སྟངས།</h2><ul><li>ལག་ལེན་དང་པོ། དེ་རིང་གང་བྱེད་དགོས་སམ། སྐད་ཡིག་གསལ་པོའི་ནང་།</li><li>མངོན་གསལ་གྱི་སྐོར་ལ་དྲང་པོ་བྱེད་དགོས། དེ་བདེན་པ་ཡིན་པའི་སྐབས་ལ་ང་ཚོས་“འབྲེལ་བ་ཡོད་”དང་།</li><li>བརྩི་བཀུར་ལྡན་པ། ང་ཚོས་རྒན་རྒོན་དུ་བློ་འཚབ་ཀྱི་ནད་ཡོད་པའི་མི་ཚོའི་སྐོར་བྲིས་ཡོད།</li><li>གསར་གཏོད་བྱས་པའི་ནང་དོན་མེད། བཟོས་པའི་རྩིས་དཔྱད་དང་། ཚིག་བཅད། ཆེད་མཁས་པ། ཞིབ་འཇུག། བསྐྱར་ཞིབ། ཡང་ན་དཔང་ཚིག་མེད།</li></ul><h2>ང་ཚོའི་ཤོག་ངོས་ལ་སུས་བསྐྱར་ཞིབ་བྱེད་པ།</h2><p>ཤོག་ངོས་དེ་ཚོ་གསེར་གྱི་དུས་སྐབས་རུ་ཁག་གིས་བྲིས་ནས་བརྟག་དཔྱད་བྱེད་ཀྱི་ཡོད། ཤོག་ངོས་རེ་རེ་བཞིན་རུ་ཁག་གིས་དེའི་ཐོན་ཁུངས་ལ་ཞིབ་བཤེར་བྱེད་ཀྱི་ཡོད། ང་ཚོའི་ངོས་སུ་ཡོད། <strong>མིན</strong> སྨན་པའམ་ཡང་ན་སྨན་པ་གཞན་གྱིས་བསྐྱར་ཞིབ་བྱས་པ་དང་། ང་ཚོས་དེ་མིན་བརྗོད་ཀྱི་མེད། དེ་དག་ནི་སྤྱིར་བཏང་གི་གནས་ཚུལ་ཡིན་པ་ལས་སྨན་པའི་བསླབ་བྱ་མ་རེད།</p><h2>ང་ཚོས་ནམ་ཡང་དཔར་བསྐྲུན་མི་བྱེད་པ།</h2><ul><li>རྩེད་མོ་དང་། ཟས་རིགས། ཁ་སྣོན། མགྱོགས་པོ་ཡང་ན་རྒྱུན་ལྡན་གྱི་བྱ་སྤྱོད་ཀྱིས་བློ་འཚབ་ཀྱི་ནད་སྔོན་འགོག་དང་།</li><li>མི་ཞིག་ལ་བློ་འཚབ་ཀྱི་ནད་གཞི་ཡོད་པའམ་ཡང་ན་མེད་པ་བསྟན་པའི་ཚོད་ལྟ་དང་། དྲི་བ། ཡང་ན་སྐར་གྲངས།</li><li>སྨན་གང་ཞིག་འགོ་འཛུགས་དང་། མཚམས་འཇོག་པ། ཡང་ན་བརྗེ་སྒྱུར་བྱེད་པའི་བསླབ་བྱ།</li><li>ཁྱབ་བསྒྲགས་ཡང་ན་སྦྱིན་བདག་གི་ནང་དོན་དེ་ལམ་སྟོན་གྱི་ངོ་བོར་བསྒྱུར་ཡོད།</li></ul><h2>གསར་བཅོས་དང་དག་སྒྲིག།</h2><p>ཤོག་ངོས་རེ་རེས་མཐའ་མའི་ཁ་སྐོང་ཚེས་གྲངས་སྟོན་གྱི་ཡོད། གལ་ཏེ་ཁྱེད་ཀྱིས་ནོར་འཁྲུལ་ཞིག་རྙེད་པའམ་ཡང་ན་དུས་ཚོད་རྫོགས་པའི་ཐོན་ཁུངས་ཤིག་རྙེད་ཚེ་གློག་འཕྲིན་གཏོང་རོགས། <a href=\"mailto:{email}\">{email}</a> ང་ཚོས་མྱུར་དུ་ཞིབ་བཤེར་བྱ་རྒྱུ་ཡིན།</p>"
